# ============================================================
# Atomic Lab 环境变量模板
# 复制为 .env 后填入真实值；.env 不入库（gitignore）
# ============================================================

# ── LLM 提供商（二选一）────────────────────────────────────
# deepseek（默认，可不设）或 aliyun
CHAT_LLM_PROVIDER=deepseek

# DeepSeek（CHAT_LLM_PROVIDER=deepseek 时必配）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 阿里云百炼（CHAT_LLM_PROVIDER=aliyun 时必配）
# ALIYUN_API_KEY=
# ALIYUN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ALIYUN_MODEL=qwen3.8-flash   # 默认 qwen3.8-flash（可用 qwen3.7-flash / qwen3.5-flash 等）

# ── Embedding 模型 ─────────────────────────────────────────
# 默认 sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 创空间默认走 ModelScope；本地设 1 也可走 ModelScope（避免直连 HuggingFace）
EMBEDDING_USE_MODELSCOPE=0
# 本地 ModelScope 缓存目录（创空间应指向 /mnt/workspace/.cache/modelscope）
# MODELSCOPE_CACHE=

# ── MinerU PDF 解析（可选，用于「上传 PDF 解析」与 demo 白皮书导出）──
# 云端 API token（mineru.net 控制台生成）；本地也可装 magic-pdf 走 CLI
# MINERU_API_TOKEN=
# MINERU_API_BASE=https://mineru.net/api/v4

# ── 检索参数（可选，默认即可）──────────────────────────────
# RAG_BM25_WEIGHT=1.0          # BM25 融合权重（默认 1.0，评测调参用）
# RAG_CHUNK_SIZE=800           # 文档分块字数
# RAG_TORCH_THREADS=1          # torch CPU 线程数（内存紧张时保持 1）
# RAG_HISTORY_TURNS=4          # 对话历史保留轮数（1 轮=2 消息）

# ── Multi-Agent 配置（可选，默认即可；评测消融用）──────────
# Seeker 查询扩展：regex（正则拆词，默认，multi-hop 更优）或 llm（语义改写）
# SEEKER_EXPAND_MODE=regex
# Reviewer 证据评审：llm（默认，LLM 打分）或 heuristic（启发式，仅展示不影响答案）
# REVIEWER_MODE=llm
# Router 工具迭代次数：2（默认，多轮检索+arXiv 补充）或 1（降延迟）
# ROUTER_MAX_ITER=2
# arXiv 补充开关：1（默认，开启）或 0（关闭，本地纯检索减噪）
# ARXIV_ENABLED=1
# Synthesizer 证据条数上限：10（默认，对齐 top_k）或 16（更多证据）
# SYNTHESIS_MAX_SOURCES=10
